#!/usr/bin/env php
<?php

declare(strict_types=1);

require_once __DIR__ . '/bootstrap/autoload.php';
$command = $argv[1] ?? 'help';
if (in_array($command, ['--help', '-h'], true)) { $command = 'help'; }

try {
    if ($command === 'new' && in_array($argv[2] ?? '', ['--help', '-h'], true)) {
        echo "Usage: php nova new directory [--stack=empty|vue|react|svelte|solid|preact|alpine] [--style=plain|tailwind|bootstrap] [--interactive]\n";
        exit(0);
    }
    $app = in_array($command, ['new', 'help'], true) ? null : require __DIR__ . '/bootstrap/app.php';
    switch ($command) {
        case 'new':
            $destination = $argv[2] ?? '';
            $stack = null;
            $style = null;
            $interactive = false;
            foreach (array_slice($argv, 3) as $option) {
                if (str_starts_with($option, '--stack=') && $stack === null) { $stack = substr($option, 8); }
                elseif (str_starts_with($option, '--style=') && $style === null) { $style = substr($option, 8); }
                elseif ($option === '--interactive' && !$interactive) { $interactive = true; }
                else { throw new RuntimeException('Usage: php nova new directory [--stack=empty|vue|react|svelte|solid|preact|alpine] [--style=plain|tailwind|bootstrap] [--interactive]'); }
            }
            if ($destination === '') { throw new RuntimeException('Specify a new project directory.'); }
            if ($stack === null) {
                if (!$interactive && !stream_isatty(STDIN)) { throw new RuntimeException('Non-interactive creation requires --stack=empty or another stack.'); }
                $stack = \Nova\Console\ProjectCreator::choose(STDIN, STDOUT);
            }
            if ($style === null && $stack !== 'empty' && ($interactive || stream_isatty(STDIN))) {
                $style = \Nova\Console\ProjectCreator::chooseStyle(STDIN, STDOUT);
            }
            $style ??= 'plain';
            $created = (new \Nova\Console\ProjectCreator(__DIR__))->create($destination, $stack, $style);
            echo "Created $created ($stack, $style).\nNext: cd " . escapeshellarg($created) . " && php nova serve\n";
            if ($stack !== 'empty') { echo "Frontend: npm install, then npm run dev or npm run build.\n"; }
            break;
        case 'serve':
            $host = $argv[2] ?? '127.0.0.1:8000';
            if (!preg_match('/^(127\.0\.0\.1|localhost):[0-9]{1,5}$/', $host)) {
                fwrite(STDERR, "Use localhost:PORT or 127.0.0.1:PORT.\n");
                exit(1);
            }
            echo "NovaPHP available at http://{$host}\n";
            $cmd = escapeshellarg(PHP_BINARY) . ' -S ' . escapeshellarg($host)
                . ' -t ' . escapeshellarg(__DIR__ . '/public') . ' ' . escapeshellarg(__DIR__ . '/public/router.php');
            passthru($cmd, $code);
            exit($code);
        case 'route:list':
            foreach ($app->router->routes() as [$method, $path]) {
                printf("%-8s %s\n", $method, $path);
            }
            break;
        case 'config:show':
            $key = $argv[2] ?? null;
            $value = $key === null ? $app->config->all() : $app->config->get($key);
            echo json_encode($value, JSON_PRETTY_PRINT | JSON_THROW_ON_ERROR) . "\n";
            break;
        case 'make:controller':
            $name = $argv[2] ?? '';
            if (!preg_match('/^[A-Z][A-Za-z0-9_]*Controller$/D', $name)) {
                fwrite(STDERR, "Use a simple class name such as PostController.\n");
                exit(1);
            }
            $path = __DIR__ . '/app/Controllers/' . $name . '.php';
            $file = @fopen($path, 'x');
            if ($file === false) {
                fwrite(STDERR, "Controller exists or cannot be created.\n");
                exit(1);
            }
            $source = "<?php\n\ndeclare(strict_types=1);\n\nnamespace App\\Controllers;\n\nfinal class {$name}\n{\n    public function index(): string\n    {\n        return 'Hello from {$name}';\n    }\n}\n";
            fwrite($file, $source);
            fclose($file);
            echo "Created app/Controllers/{$name}.php\n";
            break;
        case 'make:model':
            if (count($argv) > 4 || (isset($argv[3]) && !str_starts_with($argv[3], '--table='))) {
                throw new RuntimeException('Usage: php nova make:model Name [--table=table_name]');
            }
            (new \Nova\Database\ModelGenerator(__DIR__ . '/app/Models'))->make(
                $argv[2] ?? '', isset($argv[3]) ? substr($argv[3], 8) : null);
            echo 'Created app/Models/' . $argv[2] . ".php\n";
            break;
        case 'make:migration':
        case 'migrate':
        case 'migrate:status':
        case 'migrate:rollback':
            if ($command === 'make:migration' && (count($argv) > 4 || (isset($argv[3]) && $argv[3] !== '--sql'))) {
                throw new RuntimeException('Usage: php nova make:migration name [--sql]');
            }
            (new \Nova\Database\Commands($app->container->make(\Nova\Database\Migrator::class),
                __DIR__ . '/database/migrations'))->run($command, $argv[2] ?? null, ($argv[3] ?? null) === '--sql');
            break;
        case 'help':
            echo "NovaPHP CLI\n  php nova new directory [--stack=empty|vue|react|svelte|solid|preact|alpine] [--style=plain|tailwind|bootstrap] [--interactive]\n  php nova serve [127.0.0.1:8000]\n  php nova route:list\n  php nova make:controller PostController\n  php nova make:model Post [--table=posts]\n  php nova config:show [app.debug]\n  php nova make:migration create_widgets [--sql]\n  php nova migrate\n  php nova migrate:status\n  php nova migrate:rollback\n";
            break;
        default:
            fwrite(STDERR, "Unknown command: {$command}\n");
            exit(1);
    }
} catch (Throwable $error) {
    fwrite(STDERR, 'Error: ' . $error->getMessage() . "\n");
    exit(1);
}
